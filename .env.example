# YouTube Shorts Ultimate — Environment Configuration
# Copy to .env OR run: python scripts/env_vault.py unseal

# AI Model Provider Keys
# GEMINI: Developer API key (aistudio.google.com). Google AI Plus chat/görsel kotası buraya geçmez.
# Senaryo = ücretsiz API tier yeterli. Görsel (Nano Banana) = billing gerekir; varsayılan kapalı.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
FAL_API_KEY=
STABILITY_API_KEY=

# Video Source API Keys
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_DATA_API_KEY=

# Reddit OAuth (optional — for live Reddit discovery)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=YouTubeShortsStudio/1.0 (research workflow)

# ElevenLabs free tier — https://elevenlabs.io/
# Settings UI writes here; if you use .env.vault run: python scripts/env_vault.py seal
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Application Settings
LANGUAGE=tr
TTS_GENDER=male
TTS_VOICE=
TTS_RATE=+18%
ENABLE_BGM=true
BGM_VOLUME=0.12
DEFAULT_BGM_TRACK=
TTS_PITCH=+0Hz
SUBTITLE_FONT_SIZE=54
SUBTITLE_COLOR=white
SUBTITLE_HIGHLIGHT_COLOR=#FFD700
SUBTITLE_Y_POSITION=0.8
ENABLE_SFX=true
SFX_VOLUME=0.20
GAMEPLAY_ROTATION_WINDOW=75
ENABLE_DIRECTOR_PLAN=true
ENABLE_FFMPEG_GRAPH=true
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Opsiyonel — açmadan stok video (Pexels/Pixabay) kullanılır; Plus abonelik API faturasını karşılamaz
USE_GEMINI_IMAGE_GEN=false
USE_GEMINI_VIDEO_GEN=false
GEMINI_VEO_PAID_QUOTA=false
GEMINI_VEO_PREVIEW_ONLY=true
USE_GEMINI_TTS=false
USE_GEMINI_GROUNDING=false
USE_GEMINI_EMBEDDINGS=false
PREFER_GEMINI_SCENE_IMAGES=false
AUTO_FETCH_ROYALTY_FREE_BGM=true
WHISPER_ALIGN=false
# false = tüm overlay/efekt aktif (Batch 1+2 görünür). true = ağır efekt bypass (varsayılan eski davranış)
RENDER_SAFE_MODE=false
RENDER_RESOLUTION_MODE=1080p
RENDER_THREADS=8
# FFmpeg thread count (RENDER_THREADS defaults to this); FFMPEG_DEBUG=true prints full ffmpeg stderr
FFMPEG_THREADS=4
FFMPEG_DEBUG=false
USE_GPU_ACCELERATION=true
GPU_CODEC=h264_nvenc
FPS_DIVERSIFY=true
# Item 323: 30 (default) or 60 for smoother export
EXPORT_FPS_MODE=30
# Item 324: did | sadtalker | liveportrait (paid — leave empty to disable)
AVATAR_ANIMATION_PROVIDER=
AVATAR_ANIMATION_API_KEY=

# P2-24 Stock copyright blocklist (comma-separated asset IDs or contributors)
STOCK_BLOCKLIST_IDS=
STOCK_BLOCKLIST_CONTRIBUTORS=

# Ops — server port for run.py / run_ui.sh (default 8000)
PORT=8000
# BGM RAM cache size (tracks kept in memory during render)
BGM_RAM_CACHE_MAX=12
# Force procedural (no-AI) scenario fallback — debugging only
SHORTS_FORCE_PROCEDURAL_FALLBACK=false

# Item 439 — encrypted SQLite backup (data/backups/*.db.enc)
# Restore: python database.py restore data/backups/<file>.db.enc restored.db
ENABLE_DB_BACKUP=false
DB_BACKUP_INTERVAL_HOURS=24
# Falls back to ENV_VAULT_PASSPHRASE, then to a fixed local default (weak — set one!)
DB_BACKUP_PASSPHRASE=
# Docker only: keep DB on the persisted ./data volume (docker-compose sets this)
# SHORTS_DB_PATH=/app/data/shorts.db

# Render error notifications (optional; both empty = disabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
